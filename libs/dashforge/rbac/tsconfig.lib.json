{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // `tsBuildInfoFile` INSIDE `dist` is load-bearing, not tidiness. The
    // build wipes `dist`; a cache left outside it survives that, so tsc
    // reads a valid cache describing declarations that no longer exist,
    // declares the project up to date and emits NOTHING. Dependents then
    // fail with TS6305, and a package that is published from that state
    // ships empty. Kept out of the tarball by a `files` negation instead.
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "outDir": "../../../dist/out-tsc/libs/dashforge/rbac",
    "composite": true,
    "types": ["node"],
    "jsx": "react"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    // Exclude the DIRECTORY, and the hyphen spelling. The `*.test.ts` /
    // `*.spec.ts` patterns miss anything named differently: `path.type-test.ts`
    // and `autocomplete.props.type-test.ts` end in `-test.ts`, not `.test.ts`,
    // and both shipped inside a published tarball because of it.
    "src/**/__tests__/**",
    "**/*-test.ts",
    "**/*-test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.tsx"
  ]
}
