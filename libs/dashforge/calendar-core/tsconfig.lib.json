{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "importHelpers": false,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "lib": ["ES2022"],
    "types": []
  },
  "include": ["src/**/*.ts"],
  "references": [],
  "exclude": [
    // Exclude the DIRECTORY, and the hyphen spelling. The `*.test.ts` /
    // `*.spec.ts` patterns miss anything named differently: `path.type-test.ts`
    // and `autocomplete.props.type-test.ts` end in `-test.ts`, not `.test.ts`,
    // and both shipped inside a published tarball because of it.
    "src/**/__tests__/**",
    "**/*-test.ts",
    "**/*-test.tsx",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ]
}
