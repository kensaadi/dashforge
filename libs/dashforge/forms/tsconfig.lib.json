{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": [
      "node",
      "@nx/react/typings/cssmodule.d.ts",
      "@nx/react/typings/image.d.ts"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": "src",
    "jsx": "react-jsx",
    // `tsBuildInfoFile` INSIDE `dist` is load-bearing, not tidiness. The
    // build wipes `dist`; a cache left outside it survives that, so tsc
    // reads a valid cache describing declarations that no longer exist,
    // declares the project up to date and emits NOTHING. Dependents then
    // fail with TS6305, and a package that is published from that state
    // ships empty. Kept out of the tarball by a `files` negation instead.
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "exclude": [
    "out-tsc",
    "dist",
    // Exclude the DIRECTORY, not a filename pattern. The `*.test.ts` /
    // `*.spec.ts` patterns below miss anything named differently, and two
    // files slipped through into the published tarball because of it:
    // `engine-typing.type-test.ts` ends in `-test.ts`, not `.test.ts`, and
    // `testHarness.ts` carries no suffix at all. Caught by the pre-publish
    // pack audit before 2.0.0.
    "src/**/__tests__/**",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.spec.tsx",
    "**/*.test.tsx",
    "**/*.spec.js",
    "**/*.test.js",
    "**/*.spec.jsx",
    "**/*.test.jsx",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.ts", "src/**/*.tsx"],
  "references": [
    {
      "path": "../ui-core/tsconfig.lib.json"
    }
  ]
}
